{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "images": {
      "additionalProperties": false,
      "properties": {
        "api": {
          "pattern": "^[A-Za-z0-9._:/@-]+$",
          "type": "string"
        },
        "operator": {
          "pattern": "^[A-Za-z0-9._:/@-]+$",
          "type": "string"
        }
      },
      "required": [
        "api",
        "operator"
      ],
      "type": "object"
    },
    "publicOrigin": {
      "pattern": "^https://[A-Za-z0-9][A-Za-z0-9.-]*(:[0-9]{1,5})?$",
      "type": "string"
    }
  },
  "required": [
    "publicOrigin",
    "images"
  ],
  "type": "object"
}
